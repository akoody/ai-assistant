{
  "name": "ai-slots",
  "version": "1.0.0",
  "description": "AI Slots микросервис для извлечения слотов из текста",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "db:init": "node scripts/init-db.js",
    "db:update": "FORCE_UPDATE=true node scripts/init-db.js",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathIgnorePatterns=/node_modules/ --runInBand src/__tests__/integration"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mongodb": "^4.17.1",
    "node-cache": "^5.1.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "@jest/globals": "^29.7.0"
  },
  "jest": {
    "transform": {},
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/src/__tests__/integration/"
    ],
    "setupFiles": [
      "<rootDir>/../../shared/testing/disableNetwork.js"
    ]
  },
  "keywords": [
    "ai",
    "slots",
    "nlp",
    "microservice"
  ],
  "author": "",
  "license": "ISC"
}
